{
  "name": "@ally-ui-mono/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:helpline": "npx nx serve ally-helpline-dashboard",
    "start:admin": "npx nx serve ally-admin-dashboard",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install || true",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "build:prod": "npx nx build ally-helpline-dashboard --configuration=production",
    "build:admin": "npx nx build ally-admin-dashboard",
    "build:helpline": "npx nx build ally-helpline-dashboard",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 npx nx run-many --target=test --all",
    "test:watch": "NODE_OPTIONS=--max-old-space-size=4096 npx nx run-many --target=test --all --watch",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=4096 npx nx run-many --target=test --all --configuration=coverage --parallel=1",
    "test:helpline": "NODE_OPTIONS=--max-old-space-size=5120 npx nx test ally-helpline-dashboard",
    "test:ui-shared": "NODE_OPTIONS=--max-old-space-size=4096 npx nx test ui-shared",
    "test:admin": "NODE_OPTIONS=--max-old-space-size=5120 npx nx test ally-admin-dashboard",
    "test:helpline:watch": "npx nx test ally-helpline-dashboard --watch",
    "test:ui-shared:watch": "npx nx test ui-shared --watch",
    "test:helpline:coverage": "npx nx test ally-helpline-dashboard --configuration=coverage",
    "test:ui-shared:coverage": "npx nx test ui-shared --configuration=coverage",
    "test:update-snapshots": "npx nx run-many --target=test --all --update",
    "test:helpline:update-snapshots": "npx nx test ally-helpline-dashboard --update",
    "test:ui-shared:update-snapshots": "npx nx test ui-shared --update",
    "test:docker": "./test-docker.sh all",
    "test:docker:helpline": "./test-docker.sh helpline",
    "test:docker:admin": "./test-docker.sh admin",
    "test:docker:ui-shared": "./test-docker.sh ui-shared",
    "test:docker:coverage": "./test-docker.sh coverage",
    "test:docker:watch": "./test-docker.sh watch",
    "test:docker:clean": "./test-docker.sh clean",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "i18n:publish": "node scripts/i18n-publish.mjs"
  },
  "private": true,
