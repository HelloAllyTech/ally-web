{
  "name": "@ally-ui-mono/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:web": "npx nx dev ally-web",
    "start:helpline": "npx nx serve ally-helpline-dashboard",
    "start:admin": "npx nx serve ally-admin-dashboard",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install || true",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "build:prod": "npx nx build ally-helpline-dashboard --configuration=production",
    "build:admin": "npx nx build ally-admin-dashboard",
    "build:helpline": "npx nx build ally-helpline-dashboard",
    "build:web": "npx nx build ally-web",
    "test": "npx nx run-many --target=test --all",
    "test:watch": "npx nx run-many --target=test --all --watch",
    "test:coverage": "npx nx run-many --target=test --all --configuration=coverage --parallel=1",
    "test:web": "npx nx test ally-web",
    "test:helpline": "npx nx test ally-helpline-dashboard",
    "test:ui-shared": "npx nx test ui-shared",
    "test:admin": "npx nx test ally-admin-dashboard",
    "test:web:watch": "npx nx test ally-web --watch",
    "test:helpline:watch": "npx nx test ally-helpline-dashboard --watch",
    "test:ui-shared:watch": "npx nx test ui-shared --watch",
    "test:web:coverage": "npx nx test ally-web --configuration=coverage",
    "test:helpline:coverage": "npx nx test ally-helpline-dashboard --configuration=coverage",
    "test:ui-shared:coverage": "npx nx test ui-shared --configuration=coverage",
    "test:update-snapshots": "npx nx run-many --target=test --all --update",
    "test:web:update-snapshots": "npx nx test ally-web --update",
    "test:helpline:update-snapshots": "npx nx test ally-helpline-dashboard --update",
    "test:ui-shared:update-snapshots": "npx nx test ui-shared --update",
    "test:docker": "./test-docker.sh all",
    "test:docker:web": "./test-docker.sh web",
    "test:docker:helpline": "./test-docker.sh helpline",
    "test:docker:admin": "./test-docker.sh admin",
    "test:docker:ui-shared": "./test-docker.sh ui-shared",
    "test:docker:coverage": "./test-docker.sh coverage",
    "test:docker:watch": "./test-docker.sh watch",
    "test:docker:clean": "./test-docker.sh clean"
  },
  "private": true,
  "overrides": {
    "stylus": "0.0.1-security"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@livekit/components-react": "^2.9.3",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@mui/x-date-pickers": "^8.2.1",
    "@react-oauth/google": "^0.13.4",
    "@reduxjs/toolkit": "^2.9.0",
    "@wavesurfer/react": "^1.0.7",
    "aria-hidden": "^1.2.6",
    "axios": "^1.12.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "emoji-picker-react": "^4.13.3",
    "framer-motion": "^12.23.22",
    "jspdf": "^3.0.1",
    "livekit-client": "^2.15.2",
    "lucide-react": "^0.468.0",
    "next": "~15.2.4",
    "react": "18.3.1",
    "react-audio-visualize": "^1.0.1",
    "react-calendar": "^6.0.0",
    "react-dom": "18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.54.2",
    "react-redux": "^9.2.0",
    "react-router": "^7.2.1",
    "react-router-dom": "^7.2.1",
    "react-table": "^7.8.0",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@eslint/js": "^9.18.0",
    "@nx/cypress": "^21.6.3",
    "@nx/devkit": "21.6.3",
    "@nx/eslint": "21.6.3",
    "@nx/eslint-plugin": "21.6.3",
    "@nx/jest": "^21.6.3",
    "@nx/js": "21.6.3",
    "@nx/next": "21.6.3",
    "@nx/react": "21.6.3",
    "@nx/vite": "21.6.3",
    "@nx/web": "21.6.3",
    "@nx/workspace": "21.6.3",
    "@react-router/dev": "^7.2.1",
    "@svgr/webpack": "^8.1.0",
    "@swc-node/register": "~1.10.9",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.10.1",
    "@swc/helpers": "~0.5.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vitest/utils": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "7.37.3",
    "eslint-plugin-react-hooks": "5.1.0",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsdom": "~25.0.1",
    "lint-staged": "^16.1.2",
    "nx": "21.6.3",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "3.4.17",
    "tslib": "^2.8.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ]
}
