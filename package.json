{
  "name": "@ally-ui-mono/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:web": "npx nx dev ally-web",
    "start:helpline": "npx nx serve ally-helpline-dashboard",
    "start:admin": "npx nx serve ally-admin-dashboard",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky && husky install",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "build:prod": "npx nx build ally-helpline-dashboard --configuration=production",
    "test": "npx nx run-many --target=test --all",
    "test:watch": "npx nx run-many --target=test --all --watch",
    "test:coverage": "npx nx run-many --target=test --all --configuration=coverage --parallel=1",
    "test:web": "npx nx test ally-web",
    "test:helpline": "npx nx test ally-helpline-dashboard",
    "test:ui-shared": "npx nx test ui-shared",
    "test:admin": "npx nx test ally-admin-dashboard",
    "test:web:watch": "npx nx test ally-web --watch",
    "test:helpline:watch": "npx nx test ally-helpline-dashboard --watch",
    "test:ui-shared:watch": "npx nx test ui-shared --watch",
    "test:web:coverage": "npx nx test ally-web --configuration=coverage",
    "test:helpline:coverage": "npx nx test ally-helpline-dashboard --configuration=coverage",
    "test:ui-shared:coverage": "npx nx test ui-shared --configuration=coverage",
    "test:update-snapshots": "npx nx run-many --target=test --all --update",
    "test:web:update-snapshots": "npx nx test ally-web --update",
    "test:helpline:update-snapshots": "npx nx test ally-helpline-dashboard --update",
    "test:ui-shared:update-snapshots": "npx nx test ui-shared --update"
  },
  "private": true,
  "overrides": {
    "stylus": "0.0.1-security"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.1.1",
    "@mui/material": "^7.1.1",
    "@react-router/node": "^7.2.0",
    "@react-router/serve": "^7.2.0",
    "@reduxjs/toolkit": "^2.9.0",
    "aria-hidden": "^1.2.6",
    "emoji-picker-react": "^4.13.3",
    "framer-motion": "^12.23.22",
    "isbot": "^4.4.0",
    "next": "~15.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "^9.2.0",
    "react-router": "^7.2.0",
    "react-router-dom": "6.29.0",
    "react-table": "^7.8.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@nx/cypress": "^21.6.3",
    "@nx/devkit": "21.1.3",
    "@nx/eslint": "21.1.3",
    "@nx/eslint-plugin": "21.1.3",
    "@nx/jest": "^21.6.3",
    "@nx/js": "21.1.3",
    "@nx/next": "21.1.3",
    "@nx/react": "21.1.3",
    "@nx/vite": "21.1.3",
    "@nx/web": "21.1.3",
    "@nx/workspace": "21.1.3",
    "@react-router/dev": "^7.2.0",
    "@svgr/webpack": "^8.1.0",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^20.0.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.0",
    "@vitest/utils": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^8.0.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "lint-staged": "^16.1.2",
    "nx": "21.1.3",
    "postcss": "^8.4.47",
    "postcss-import": "^16.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "3.4.3",
    "tslib": "^2.3.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ]
}
