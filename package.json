    "husky": "^8.0.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "lint-staged": "^16.1.2",
    "nx": "21.1.3",
    "postcss": "^8.4.47",
    "postcss-import": "^16.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "3.4.3",
    "tslib": "^2.3.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
