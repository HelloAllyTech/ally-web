    "@react-router/node": "^7.2.0",
    "@react-router/serve": "^7.2.0",
    "aria-hidden": "^1.2.6",
    "isbot": "^4.4.0",
    "next": "~15.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@nx/devkit": "21.1.3",
    "@nx/eslint": "21.1.3",
    "@nx/eslint-plugin": "21.1.3",
    "@nx/js": "21.1.3",
    "@nx/next": "21.1.3",
    "@nx/react": "21.1.3",
    "@nx/vite": "21.1.3",
