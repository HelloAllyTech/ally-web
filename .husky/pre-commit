#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run with Node 22+ (fixes string-width regex 'v' flag on Node 18)
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
export CI=true
export NX_NO_CLOUD=true

if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm exec 22 sh -c 'echo "Running tests before commit..."; npm test; npx lint-staged'
else
  echo "Running tests before commit..."
  npm test
  npx lint-staged
fi
