# Dev image for lifeline-admin-dashboard (Vite)
# Use prebuilt deps image to leverage cached node_modules
FROM lifeline-web/deps:dev

# Set working directory for subsequent commands
WORKDIR /app

# Install dependencies using workspace manifests for cache efficiency
COPY package*.json ./
COPY nx.json ./
COPY tsconfig.base.json ./

RUN npm ci --legacy-peer-deps

# Configure development environment variables
ENV NODE_ENV=development

# Expose Vite dev server port
EXPOSE 8081

# Run vite directly; compose maps 8081->8081
# Start the Vite dev server via Nx
CMD ["npx", "nx", "serve", "lifeline-admin-dashboard", "--host=0.0.0.0", "--port=8081"]
