# Stage 1: Build
FROM node:20 AS builder

WORKDIR /app

# Copy all workspace configuration files first
COPY package*.json ./
COPY nx.json ./
COPY tsconfig.base.json ./
COPY eslint.config.mjs ./

# Copy ALL project package.json files to ensure proper workspace setup
COPY apps/ally-web/package*.json ./apps/ally-web/
COPY libs/ui-shared/package*.json ./libs/ui-shared/

# Install ALL dependencies from workspace root (this handles both root and workspace dependencies)
RUN npm ci --legacy-peer-deps

# Copy source files
COPY apps/ally-web ./apps/ally-web
COPY libs ./libs

# Build the application using Nx with skip-nx-cache to avoid building dependencies
RUN ./node_modules/.bin/nx build ally-web --skip-nx-cache

# Stage 2: Serve
FROM node:20-alpine AS runner

WORKDIR /app

# Create a non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy the public folder
COPY --from=builder /app/dist/apps/ally-web/public ./public

# Set the correct permission for prerender cache
RUN mkdir .next
RUN chown nextjs:nodejs .next

# Copy the built application
COPY --from=builder --chown=nextjs:nodejs /app/dist/apps/ally-web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/dist/apps/ally-web/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

# Start the application
CMD ["node", "server.js"] 