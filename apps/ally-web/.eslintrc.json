{
  "extends": [
    "../../.eslintrc.json",
    "next/core-web-vitals"
  ],
  "ignorePatterns": [
    "!**/*",
    ".next/**/*",
    "out/**/*"
  ],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {
        "@typescript-eslint/no-empty-function": ["error", { "allow": ["arrowFunctions"] }]
      }
    }
  ]
} 