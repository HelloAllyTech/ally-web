# Dev image for lifeline-web (Next.js)
# Use prebuilt deps image to leverage cached node_modules
FROM lifeline-web/deps:dev

# Set working directory for subsequent commands
WORKDIR /app

# Install dependencies at image build using workspace manifests for better caching
COPY package*.json ./
COPY nx.json ./
COPY tsconfig.base.json ./
COPY apps/lifeline-web/package*.json ./apps/lifeline-web/

RUN npm ci --legacy-peer-deps

# Configure development environment variables
ENV NODE_ENV=development
ENV HOST=0.0.0.0
ENV WATCHPACK_POLLING=true

# Expose Next.js dev server port
EXPOSE 3000

# Start the Next.js dev server via Nx
CMD ["npx", "nx", "dev", "lifeline-web", "--hostname", "0.0.0.0"]