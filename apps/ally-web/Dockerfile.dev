# Dev image for ally-web (Next.js)
FROM node:20-alpine

WORKDIR /app

# Install dependencies at image build using workspace manifests for better caching
COPY package*.json ./
COPY nx.json ./
COPY tsconfig.base.json ./
COPY apps/ally-web/package*.json ./apps/ally-web/
COPY libs/ui-shared/package*.json ./libs/ui-shared/

RUN npm ci --legacy-peer-deps

ENV NODE_ENV=development
ENV HOST=0.0.0.0
ENV WATCHPACK_POLLING=true

EXPOSE 3000

CMD ["sh", "-lc", "if [ ! -d node_modules ] || [ -z \"$(ls -A node_modules 2>/dev/null)\" ]; then npm ci --legacy-peer-deps; fi; npx nx dev ally-web --hostname 0.0.0.0"]
