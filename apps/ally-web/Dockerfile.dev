# Dev image for ally-web (Next.js)
# Use prebuilt deps image which already has all dependencies and workspace setup
FROM ally-web/deps:dev

# Set working directory for subsequent commands
WORKDIR /app

# Configure development environment variables
ENV NODE_ENV=development
ENV HOST=0.0.0.0
ENV WATCHPACK_POLLING=true

# Expose Next.js dev server port
EXPOSE 3000

# Start the Next.js dev server via Nx
CMD ["npx", "nx", "dev", "ally-web", "--hostname", "0.0.0.0"]