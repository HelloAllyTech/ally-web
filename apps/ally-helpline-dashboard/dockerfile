# Stage 1: Build
FROM node:20 AS builder

WORKDIR /app

# Copy workspace package files
COPY package*.json ./
COPY nx.json ./
COPY tsconfig.base.json ./
COPY eslint.config.mjs ./

# Install root dependencies
RUN npm ci

# Copy app package.json and install app dependencies
COPY apps/ally-helpline-dashboard/package*.json ./apps/ally-helpline-dashboard/
WORKDIR /app/apps/ally-helpline-dashboard
RUN npm ci

# Copy source files
WORKDIR /app
COPY apps/ally-helpline-dashboard ./apps/ally-helpline-dashboard
COPY libs ./libs

# Build the application using Nx
RUN npx nx build ally-helpline-dashboard

# Stage 2: Serve
FROM node:20-alpine

WORKDIR /app

# Install serve
RUN npm install -g serve

# Copy built files from builder
COPY --from=builder /app/dist/apps/ally-helpline-dashboard ./dist

# Expose the app's port
EXPOSE 8080

# Start serve
CMD ["serve", "-s", "dist", "-l", "8080"]