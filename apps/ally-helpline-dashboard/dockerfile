# Stage 1: Build
FROM node:20 AS builder

WORKDIR /app

# Copy all workspace configuration files first
COPY package*.json ./
COPY nx.json ./
COPY tsconfig.base.json ./

# Copy ALL project package.json files to ensure proper workspace setup
COPY apps/ally-helpline-dashboard/package*.json ./apps/ally-helpline-dashboard/
COPY libs/ui-shared/package*.json ./libs/ui-shared/

# Install ALL dependencies from workspace root (this handles both root and workspace dependencies)
RUN npm ci --legacy-peer-deps

# Copy source files
COPY apps/ally-helpline-dashboard ./apps/ally-helpline-dashboard
COPY libs ./libs

# Build the application using the locally installed Nx
RUN ./node_modules/.bin/nx build ally-helpline-dashboard

# Stage 2: Serve
FROM node:20-alpine

WORKDIR /app

# Install serve with silent option
RUN npm install -g serve

# Copy built files from builder
COPY --from=builder /app/dist/apps/ally-helpline-dashboard ./dist

# Expose the app's port
EXPOSE 8080

# Start serve with silent flag to reduce logging
CMD ["serve", "-s", "dist", "-l", "8080", "--no-request-logging"]
