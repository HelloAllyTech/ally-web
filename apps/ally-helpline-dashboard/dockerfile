# Stage 1: Build
FROM node:20 AS builder

WORKDIR /app

# Install all dependencies (including dev)
COPY package*.json ./
RUN npm install

# Stage 2: Runtime
FROM node:20-alpine
WORKDIR /app

# Copy source files and build the app
COPY . .
COPY --from=builder /app/node_modules ./node_modules
RUN npm run build

# Expose the app's port
EXPOSE 8080

# Start the app
CMD ["npm", "run", "dev"]