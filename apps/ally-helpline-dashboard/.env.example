VITE_API_BASE_URL=https://sample-url.com
# Optional: LiveKit WebRTC URL (for voice/video rooms)
VITE_LIVEKIT_URL=wss://your-livekit-url.com
# Optional: Google OAuth client ID
VITE_GOOGLE_AUTH_CLIENT_ID=

# Origin of the Ally Admin console, for the "Ally Admin" nav link shown to users
# who also hold a platform admin role. Defaults to the production console when
# unset, so every non-prod environment must set it explicitly.
VITE_ADMIN_APP_URL=http://localhost:8081

# PostHog analytics — get key from PostHog → Project Settings → Project API Key
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_ENABLED=true

VITE_I18N_BASE_URL=http://localhost:8090
# Google Tag Manager container id (e.g. GTM-XXXXXXX). Leave empty to disable GTM entirely.
VITE_GTM_ID=
# Feature flag: recommended "next challenge" after a role play (difficulty progression)
VITE_NEXT_CHALLENGE_FLAG=false
