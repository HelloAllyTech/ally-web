VITE_API_BASE_URL=https://sample-url.com
# Optional: LiveKit WebRTC URL (for voice/video rooms)
VITE_LIVEKIT_URL=wss://your-livekit-url.com
# Optional: Google OAuth client ID
VITE_GOOGLE_AUTH_CLIENT_ID=

# PostHog analytics — get key from PostHog → Project Settings → Project API Key
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_ENABLED=true

VITE_I18N_BASE_URL=http://localhost:8090

# Developer login buttons on the login page (skip OTP). Auto-shown on the dev
# server; set to "true" to force them on in a non-dev build. The backend also
# gates POST /auth/dev-login to NODE_ENV=local, so this is inert in production.
# VITE_ENABLE_DEV_LOGIN=true
# Optional overrides for the seeded accounts the buttons log in as:
# VITE_DEV_LOGIN_ADMIN_EMAIL=org-admin@example.com
# VITE_DEV_LOGIN_USER_EMAIL=learner@example.com