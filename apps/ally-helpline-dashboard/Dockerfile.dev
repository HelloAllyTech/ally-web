# Dev image for ally-helpline-dashboard (Vite)
# Use prebuilt deps image which already has all dependencies and workspace setup
FROM ally-web/deps:dev

# Set working directory for subsequent commands
WORKDIR /app

# Configure development environment variables
ENV NODE_ENV=development

# Expose Vite dev server port
EXPOSE 8080

# Start the Vite dev server via Nx
CMD ["npx", "nx", "serve", "ally-helpline-dashboard"]
