# Dev image for ally-helpline-dashboard (Vite)
# Use prebuilt deps image to leverage cached node_modules
FROM ally-web/deps:dev

# Set working directory for subsequent commands
WORKDIR /app

# Install dependencies using workspace manifests for cache efficiency
COPY package*.json ./
COPY nx.json ./
COPY tsconfig.base.json ./
COPY apps/ally-helpline-dashboard/package*.json ./apps/ally-helpline-dashboard/

RUN npm ci --legacy-peer-deps

# Configure development environment variables
ENV NODE_ENV=development

# Expose Vite dev server port
EXPOSE 8080

# Start the Vite dev server via Nx
CMD ["npx", "nx", "serve", "ally-helpline-dashboard"]
