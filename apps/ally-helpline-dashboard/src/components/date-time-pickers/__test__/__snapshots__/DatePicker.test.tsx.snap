exports[`DatePicker > should match snapshot when fully rendered 1`] = `
<DocumentFragment>
  <div
    class="cds--form-item"
  >
    <div
      class="cds--date-picker cds--date-picker--single"
    >
      <div
        class="cds--date-picker-container cds--date-picker--nolabel"
      >
        <div
          class="cds--date-picker-input__wrapper"
        >
          <span>
            <input
              class="cds--date-picker__input cds--date-picker__input--md flatpickr-input"
              id="date-picker-input"
              pattern="\\\\d{1,2}\\\\/\\\\d{1,2}\\\\/\\\\d{4}"
              placeholder="dd/mm/yyyy"
              type="text"
            />
            <svg
              aria-hidden="true"
              class="cds--date-picker__icon"
              fill="currentColor"
              focusable="false"
              height="16"
              preserveAspectRatio="xMidYMid meet"
              role="img"
              viewBox="0 0 32 32"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M26,4h-4V2h-2v2h-8V2h-2v2H6C4.9,4,4,4.9,4,6v20c0,1.1,0.9,2,2,2h20c1.1,0,2-0.9,2-2V6C28,4.9,27.1,4,26,4z M26,26H6V12h20 V26z M26,10H6V6h4v2h2V6h8v2h2V6h4V10z"
              />
            </svg>
          </span>
        </div>
      </div>
    </div>
  </div>
</DocumentFragment>
