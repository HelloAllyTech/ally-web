            class="-mb-px flex space-x-8"
          >
            <button
              class="relative font-normal whitespace-nowrap py-3 px-3 text-base min-w-[90px] leading-6 text-primary-500"
              data-testid="tab-1"
            >
              Session Review 
              <span
                aria-hidden="true"
                class="absolute bottom-[0px] left-1/2 -translate-x-1/2 h-[3px] w-full rounded-tl-lg rounded-tr-lg bg-primary-500"
              />
            </button>
            <button
              class="relative font-normal whitespace-nowrap py-3 px-3 text-base min-w-[90px] leading-6 text-typography-900 hover:text-typography-900"
              data-testid="tab-4"
            >
              Ask AI 
            </button>
            <button
              class="relative font-normal whitespace-nowrap py-3 px-3 text-base min-w-[90px] leading-6 text-typography-900 hover:text-typography-900"
              data-testid="tab-2"
            >
              Annotated Transcript 
            </button>
            <button
              class="relative font-normal whitespace-nowrap py-3 px-3 text-base min-w-[90px] leading-6 text-typography-900 hover:text-typography-900"
              data-testid="tab-5"
            >
              Skills  Demonstrated 
            </button>
            <button
              class="relative font-normal whitespace-nowrap py-3 px-3 text-base min-w-[90px] leading-6 text-typography-900 hover:text-typography-900"
              data-testid="tab-6"
            >
              Deeper Reflection 
            </button>
          </nav>
        </div>
        <div
          class="flex min-h-0 w-full flex-1 flex-col overflow-hidden"
