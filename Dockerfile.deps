# Base workspace deps image for dev
# Multi-stage: deps stage builds and caches node_modules
FROM node:20-alpine AS deps
WORKDIR /app

# Install git for husky
RUN apk add --no-cache git

# Seed cache with workspace manifests
COPY package*.json ./
COPY nx.json ./
COPY tsconfig.base.json ./
# Include libs manifests (extend if new libs are added)
COPY libs/ui-shared/package*.json ./libs/ui-shared/

# Install all workspace deps once, skip prepare script (husky)
RUN npm ci --legacy-peer-deps --ignore-scripts

# Update browserslist database to ensure browser compatibility data is current
RUN npx update-browserslist-db@latest

# Final minimal base that contains node_modules
FROM node:20-alpine
# Install git for husky
RUN apk add --no-cache git
# Set working directory for final runtime image
WORKDIR /app
# Copy cached node_modules from deps stage to final image
COPY --from=deps /app/node_modules /app/node_modules
